# ─────────────────────────────────────────────────────────────────────────────
# Halden WMS — environment variables
# Copy to `.env` for local development; set the same keys in Vercel → Settings →
# Environment Variables for production. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection used by the app.
# Hosted providers (Neon, Supabase, Vercel Postgres) give you a *pooled* URL — use it here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Direct (non-pooled) connection used only by migrations.
# If your provider gives a single URL, use the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# Only used by `npm run db:seed` (demo data). Minimum 8 characters each.
SEED_ADMIN_PASSWORD=""
SEED_USER_PASSWORD=""
